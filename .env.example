# Public build-time setting. Mobile values are copied into the app bundle.
LAB_API_BASE_URL=http://10.0.2.2:3000
LAB_DEMO_SECRET=FAKE-DEMO-ENV-SECRET-NOT-A-CREDENTIAL

# Local API settings. Keep real credentials out of the lab entirely.
API_HOST=127.0.0.1
API_PORT=3000
AUTHZ_MODE=vulnerable
LAB_ALLOW_RESET=true
LAB_DB_PATH=./lab.sqlite
