{
  "name": "insecurebank-rn-lab",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/api"],
  "scripts": {
    "start": "node scripts/with-env.js react-native start",
    "android": "node scripts/with-env.js react-native run-android",
    "build:apk": "node scripts/with-env.js sh scripts/build-demo-apk",
    "api": "npm run dev -w @insecurebank/api",
    "api:corrected": "AUTHZ_MODE=corrected npm run dev -w @insecurebank/api",
    "reset": "npm run reset -w @insecurebank/api",
    "test": "npm run test -w @insecurebank/api",
    "typecheck": "tsc --noEmit && npm run typecheck -w @insecurebank/api"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22.11.0" }
}
